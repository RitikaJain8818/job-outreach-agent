# Environment — Job Outreach Agent
# Copy this file to .env and fill in values. Never commit .env.

# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# PostgreSQL for prod:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/outreach

# ─── LLM Provider ────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# LLM_FALLBACK_PROVIDER=openai

# ─── Gmail ───────────────────────────────────────────────────
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Scopes are hardcoded in auth.py — do not change here

# ─── Outreach Defaults ───────────────────────────────────────
DEFAULT_FOLLOW_UP_DAYS=3
DEFAULT_MAX_FOLLOW_UPS=2

# ─── Sender Profile (your identity for email personalization) ─────────────────
SENDER_NAME=Ritika Jain
SENDER_EMAIL=ritikajain49026@gmail.com
# Your background — the more specific, the better the AI-generated emails
SENDER_BACKGROUND=ML Engineer with 4 years of experience in Python, LLMs, and data pipelines. Built production ML systems at scale. Looking for senior ML roles at AI-first companies.
SENDER_TONE=professional
